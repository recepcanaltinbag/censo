##############################################################################
#  The detection and quantification limit, in CHMO
##############################################################################

censo:limitOfDetection rdfs:seeAlso obo:CHMO_0002801 ;
    rdfs:comment """CHMO's term is an owl:Class -- a `figure of merit` of an assay, defined from the IUPAC Gold Book -- and this is an owl:DatatypeProperty on the method. Same concept, different kind of entity, so this is a pointer and not a mapping. The difference is the contribution: CHMO can say what a method's limit is and has no property relating it to a result, which is why a measurement cannot be called censored in it."""@en .

obo:CHMO_0002801 rdfs:label "limit of detection"@en .

censo:limitOfQuantification rdfs:seeAlso obo:CHMO_0002802 ;
    rdfs:comment """As above. CHMO records `LOQ` as a synonym and cites the IUPAC Gold Book. This is the limit the legal tests are written about -- Article 3(3b) of 2008/105/EC and Article 4(1) of 2009/90/EC -- so it is the one a monitoring release reports and the one this alignment matters most for."""@en .

obo:CHMO_0002802 rdfs:label "limit of quantification"@en .

