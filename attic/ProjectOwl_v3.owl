    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Basin -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Basin">
