          }
        ]
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b28",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/exceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/RegulationPackage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A self-contained set of thresholds attributable to one legal\ninstrument at one point in time. Assessment is always relative to a package;\nthere is no such thing as an unqualified compliance verdict.\n\nA package is a censo:Regulation -- the same legal instrument, at the granularity\nat which it is versioned, cited and swapped. Declaring them separate classes\nmade cereg:definesThreshold and censo:definedBy incoherent as inverses, which\nOOPS! reported as a critical pitfall and which is why an individual previously\nhad to be typed as both."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulation package"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://w3id.org/censo/Regulation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/FractionCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The threshold refers to one fraction of the water sample.\nUnder EU law the water standards for cadmium, lead, mercury and nickel refer to\nthe dissolved concentration, the phase passing a 0.45 µm filter (Directive\n2008/105/EC, Annex I, Part B, point 3). A result on another fraction is not a\nmeasurement of the quantity the standard is written on and supports no verdict.\n\nRETIRED AND RESTORED. An earlier version declared this class and retired it\nbecause no shipped graph exercised it: every metal assessment was\ncenso:PreconditionUnmet for want of hardness, so the fraction was never the\nquestion. Joining the hardness the record reports elsewhere made it the\nquestion, and the record answers it -- roughly half of the metal station-years\nin Waterbase are whole-water results."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fraction condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/TranscriptionStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How reliably a threshold value was copied from its legal source. Machine-readable so unverified values can be excluded from analysis rather than trusted by default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transcription status"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/atStation",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Where the sample was taken."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "at station"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/sosa/FeatureOfInterest"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/defaultUncertaintyFactor",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "U / T applied to a measured value when the record reports no\nuncertainty: 0.5 under Directive 2009/90/EC, Article 4(1), which permits an\nexpanded uncertainty of 50 % at the level of the standard. Zero is simple\nacceptance -- a point comparison with no band."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "default uncertainty factor"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Analyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A substance whose concentration is the observed property.\n\nAn Analyte is NOT the substance. It is a sosa:ObservableProperty — the\nconcentration OF a substance — while a chemical ontology's class is the\nsubstance itself, whose instances are molecules. The distinction decides how\nthe two are related: ontology/censo-alignment.ttl points each analyte at its\nChEBI class with rdfs:seeAlso, and reserves owl:sameAs for the relation that IS\nan identity, between two regulation packages' names for one observable\nproperty. That is what lets a European and a Turkish package resolve to one\nthing, which is the precondition for comparing them.\n\nThis comment used to claim the alignment was made with skos:exactMatch. It was\nmade with nothing at all: the only occurrence of skos:exactMatch in the whole\nontology was inside this sentence, and the comparison worked by joining CAS\nstrings in Python. The alignment module now exists and the audit checks that\nevery substance the dual-regulation analysis treats as co-regulated is\nreconciled by it."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservableProperty"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b10",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDisjointClasses"
    ],
    "http://www.w3.org/2002/07/owl#members": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/reg/RegulationPackage"
          },
          {
            "@id": "https://w3id.org/censo/reg/SubstanceGroup"
          },
          {
            "@id": "https://w3id.org/censo/reg/AggregationFunction"
          },
          {
            "@id": "https://w3id.org/censo/reg/TranscriptionStatus"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Threshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A concentration limit set by a regulation, together with the conditions under which it may lawfully be applied."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AssessedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An observation whose detection status has been determined; the union of the four statuses."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Assessed observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2002/07/owl#hasKey": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/hasAnalyte"
          },
          {
            "@id": "https://w3id.org/censo/atStation"
          },
          {
            "@id": "https://w3id.org/censo/duringCampaign"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/definesThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a package to the thresholds it establishes. The inverse direction (threshold to package) goes through censo:definedBy."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "defines threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/LimitAbovePerformanceCriterion",
    "@type": [
      "https://w3id.org/censo/AssessmentFlag"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The method fails the performance criterion of Directive 2009/90/EC, Article 4(1), whatever the verdict."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit of quantification above 30 % of the standard"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/casNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Preferred join key across heterogeneous sources; more\nreliable than trade or trivial names.\n\nNOT owl:FunctionalProperty, and the correction is worth recording. It was\ndeclared functional, and the released EU package violates that on three\nentries, because Annex I names more than one registry number for a single\nregulated substance: diclofenac as the free acid (15307-86-5) and as the sodium\nsalt (15307-79-6), and likewise acetamiprid and imidacloprid. A regulatory\nentry is not a single chemical species, and the data were right.\n\nThe violation was invisible. A functional datatype property with two distinct\nliterals on one subject makes the ontology inconsistent under DL semantics, but\nOWL 2 RL derives owl:sameAs between the literals and stops there, so owlrl\nreports no owl:Nothing and the audit's package-consistency check passed on every\nrun. scripts/99_audit.py::check_functional_properties now looks directly."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CAS registry number"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "http://xmlns.com/foaf/0.1/Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from FOAF; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Person"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/exceeds",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultLowerBound > thresholdValue: exceedance holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "exceeds"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyDisjointWith": [
      {
        "@id": "https://w3id.org/censo/belowThreshold"
      },
      {
        "@id": "https://w3id.org/censo/possiblyExceeds"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b22",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDisjointClasses"
    ],
    "http://www.w3.org/2002/07/owl#members": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/CensoredObservation"
          },
          {
            "@id": "https://w3id.org/censo/EstimatedObservation"
          },
          {
            "@id": "https://w3id.org/censo/QuantifiedObservation"
          },
          {
            "@id": "https://w3id.org/censo/UnresolvedObservation"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/CensoredObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The analyte was sought and the result was reported as below a\nreporting limit L. Asserts only that the true concentration lies in [0, L]. It\ndoes NOT assert absence, and storing such an observation as 0 destroys the\ndistinction and biases every derived aggregate downwards.\n\nWHICH LIMIT L IS, and why this comment used to say the wrong one. It said\n[0, LOD]. Everything that acts on this class uses the limit of QUANTIFICATION:\nthe rule in censo:MethodInsufficientRuleShape compares LOQ with the threshold,\nbecause Article 3(3b) of Directive 2008/105/EC is written on a result \"reported\nas less than the limit of quantification\"; and the WISE-6 flag this class is\npopulated from is a below-LOQ flag. Stated as LOD, the class would let a\nnon-detection with LOD <= T < LOQ be Compliant on its own interval and\nMethodInsufficient by the rule at the same time. L is the limit the result was\nreported against, and under the Directive that is the quantification limit.\n\nWHAT THIS CLASS THEREFORE CONTAINS that its name does not say. A concentration\nbetween LOD and LOQ was DETECTED and could not be quantified: an estimated\nvalue, censo:EstimatedObservation. WISE-6 gives it the same flag as a true\nnon-detection and no field separates them, so both arrive here. The vocabulary\ncan express the difference and this record cannot supply it -- which is the\npaper's own thesis turned on its own ABox, and the reason\ncenso:EstimatedObservation is declared and never populated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Censored observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b4"
      },
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b5"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      },
      {
        "@id": "https://w3id.org/censo/AssessedObservation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Observation whose result is reported as below the reporting limit of the method used, without asserting absence."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Atrazine sought and reported below a quantification limit of 0.02 µg/L: the concentration lies in [0, 0.02], which is not the same claim as zero."
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b4",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#hasValue": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#decimal",
        "@value": "0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/resultLowerBound"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b5",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#complementOf": [
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b6"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b6",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/exceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/assessmentFlag",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An annotation on an assessment that never changes its\nverdict. Flags carry what a legal reading and a metrological reading disagree\nabout, so that the verdict stays the Directive's and the disagreement stays\nqueryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessment flag"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/AssessmentFlag"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MethodInsufficient",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (b): the observation is CENSORED and its\nlimitOfQuantification exceeds the thresholdValue, so Article 3(3b) of Directive\n2008/105/EC provides that the result \"shall not be considered\" for status\nassessment. The censoring condition is part of the case: a quantified result\nabove the standard is evidence of exceedance whatever the method's limit was, and\nis not set aside by this provision."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Method insufficient"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#scopeNote": [
      {
        "@language": "en",
        "@value": "Article 3(3b) is written about the limit of\nQUANTIFICATION, and this class is scoped to it.\n\nA narrower case exists in principle: a threshold falling below the limit of\nDETECTION, where the measurement cannot even establish presence. An earlier\nversion declared censo:CensoredAmbiguous for it. No European monitoring release\nstates a detection limit -- WISE-6 carries procedureLOQValue and nothing else --\nso no row can be shown to be in that case, and a class no data can reach is a\npromise rather than a term. It is retired, on the same rule that retired\ncenso:ClassBoundaryThreshold (censo:FractionCondition, retired by the same rule,\nwas restored in 2.4.0 once data reached it), and the distinction is\nrecorded here instead: where a release does report a detection limit, the\nnarrower case is the one where the threshold falls below it, and it is strictly\ninside this class."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/memberOfGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Membership in a collectively assessed set. Group membership is curated knowledge with provenance, not a spreadsheet column."
      },
      {
        "@language": "en",
        "@value": "The group standards this analyte counts towards. Emitted by\nevery package that declares a group threshold, because a sum standard whose\nmembership is not stated cannot be assessed: the question \"was all of it\nmeasured\" has no answer, and the answer is what decides between an aggregate\nverdict and censo:IndeterminateCompliance.\n\nThis replaces cereg:groupCoverage, which was declared as the FRACTION of a\ngroup actually measured, domained on a reified assessment, ranged xsd:double --\nand emitted by the package builder as the integer COUNT of declared members, on\nthe group. Three mismatches in one triple. The count it really carried is\nderivable from these memberships with COUNT, so the property is gone rather\nthan renamed, and the coverage the manuscript reports is an analysis result\nthat belongs in the analysis and not in the regulation package."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "member of group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/belowThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultUpperBound <= thresholdValue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "below threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b15",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDisjointClasses"
    ],
    "http://www.w3.org/2002/07/owl#members": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/AnnualAverageThreshold"
          },
          {
            "@id": "https://w3id.org/censo/MaximumAllowableThreshold"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/requiresCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A precondition of the threshold. Unmet preconditions yield no verdict, not a default pass."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/censoringRecovered",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when the detection status was RECONSTRUCTED after the\nfact, typically because the source recorded a non-detection as 0 and the status\nwas recovered by joining the analyte's LOD. Such observations carry an extra\nassumption and must remain distinguishable from those whose censoring was\nrecorded at source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "censoring recovered"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/prov#hadPrimarySource",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from PROV-O; declared here only so that this standalone distribution is self-describing. Its domain and range are PROV-O's to state, not ours."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Had primary source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MatrixCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Restricts the threshold to a matrix: inland surface water, coastal water, biota, sediment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Matrix condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/BoundNotEstablished",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (e): the record establishes no bound to compare against\nthe threshold. Either nothing says whether the number is a measurement — neither\na censoring flag nor a limit is reported, so no interval can be built — or the\nresult is flagged as below a limit the record does not state. The distinction from\nMethodInsufficient matters: there the bound is known and known to be too wide,\nhere there is no bound at all, and the two call for different repairs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bound not established"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MaximumAllowableThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Short-term limit (e.g. MAC-EQS); may be compared against a single observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Maximum allowable threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Maximum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "maximum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/jurisdiction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The legal territory in which the package applies (ISO 3166 code or 'EU')."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "jurisdiction"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/Jurisdiction"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/uncertaintySource",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether censo:expandedUncertainty was reported with the result or supplied as the regulation package's default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "uncertainty source"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/UncertaintySource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/BioavailabilityCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The threshold is a bioavailable concentration (as for nickel\nand lead under EU law) and requires hardness, dissolved organic carbon and pH\nfor normalisation.\n\nNOT \"no statement is possible\", which is what this comment said until 2.4.0.\nThe bioavailable concentration cannot exceed the dissolved one, so a dissolved\nresult that clears the standard clears it for the bioavailable fraction too:\nthe first tier of CIS Guidance No. 38 (2019), section 2.2.1, which compares the\ndissolved annual average directly with the bioavailable standard. Only that\npass is decided without the covariates -- an apparent exceedance needs a\nbioavailability model and stays censo:PreconditionUnmet -- and the rule layer\nstates the exception in censo:PreconditionRuleShape."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bioavailability condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/determinesAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The analyte this method measures. One method may cover many analytes, each with its own limits, so limits are asserted per method-analyte pair."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "determines analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/QuantifiedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Detected at or above the limit of quantification; the magnitude is usable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Quantified observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      },
      {
        "@id": "https://w3id.org/censo/AssessedObservation"
      },
      {
        "@id": "https://w3id.org/censo/DetectedObservation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Vocabulary for expressing environmental quality\nstandards as self-contained, versioned, swappable modules, including group and\nderived thresholds such as a total-pesticide sum."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "CENSO-REG: pluggable regulation packages for censored observations"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "cereg"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/censo/reg/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://qudt.org/schema/qudt/"
      },
      {
        "@id": "http://www.w3.org/2004/02/skos/core"
      },
      {
        "@id": "http://www.w3.org/ns/prov#"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/"
      },
      {
        "@id": "http://www.w3.org/ns/ssn/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/censo/reg/2.4.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "2.4.0"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/HardnessClassCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The threshold varies by water hardness class, as for cadmium.\nWithout a hardness measurement the applicable class — and therefore the\napplicable threshold — is unknown.\n\nA package states one threshold per class, each requiring its own condition\nindividual with the class's covariate range (censo:covariateMinimum,\ncenso:covariateMaximum). An observation satisfies the condition of the class its\nwater falls in, and is assessed against that threshold alone. Monitoring\nreleases rarely report hardness on the measurement row; they often report it,\nor calcium and magnesium, on rows of their own at the same station and time,\nand that join is what supplies the class."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Hardness class condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/covariateMaximum",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Exclusive upper end of the covariate range over which the condition holds; absent for an open-ended class such as cadmium class 5, '≥ 200 mg CaCO3/l'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "covariate maximum"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/ReportedUncertainty",
    "@type": [
      "https://w3id.org/censo/UncertaintySource"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "reported with the result"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/ArithmeticMean",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "arithmetic mean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/requiresCompleteGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when every group member must have been measured for the\naggregate to be assessable. If members are missing from the monitoring panel,\nthe aggregate is `censo:IndeterminateCompliance`, not a partial sum. The 24-PFAS\nsum is the obvious case: a survey that measured none of them cannot report\ncompliance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires complete group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/GuardBanded",
    "@type": [
      "https://w3id.org/censo/reg/CensoredResultRule"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The uncertainty band applies to the limit as it does to a\nmeasured value, so a limit within U of the standard yields PossibleExceedance. A\nprecautionary reading in which a non-detection is never decided more strongly\nthan a measurement at the same level; not the Directive's."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "guard-banded comparison"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reportedValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The number as it appears in the source record, kept verbatim for\nprovenance. Never use it directly in inference: in many datasets a reported 0 is\na non-detection, not a measured zero."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "reported value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AnnualAverageThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Long-term limit (e.g. AA-EQS). Applies to a temporal mean, not\nto a single sample; comparing one grab sample against it is a category error that\nthis class exists to make visible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Annual average threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Jurisdiction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A legal territory in which a regulation package applies, identified by an ISO 3166 code or by 'EU'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Jurisdiction"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Sum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/NoThresholdDefined",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (a): the regulation sets no limit for this analyte in this matrix."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "No threshold defined"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/covariateUnit",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Unit of censo:covariateMinimum and censo:covariateMaximum. A class boundary without a unit cannot be compared with a measured hardness."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "covariate unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://qudt.org/schema/qudt/Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/UnresolvedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Made, but its detection status cannot be established, typically\nbecause the applicable LOD/LOQ for the analyte-method pair is unknown. Such\nobservations are structurally undecidable and must be excluded from inference\nrather than silently treated as quantified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unresolved observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b2"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      },
      {
        "@id": "https://w3id.org/censo/AssessedObservation"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b2",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#complementOf": [
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b3"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b3",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitOfDetection",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Lowest concentration reliably distinguishable from a blank.\nBelow it, presence can be neither asserted nor denied. Expressed in\ncenso:limitUnit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit of detection (LOD)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/sourceDocument",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dereferenceable URI of the legal text the values were transcribed from. Required: a threshold without a traceable source is not usable in a regulatory context."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source document"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#hadPrimarySource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/conditionSatisfied",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised by the rule layer when the observation demonstrably meets the condition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "condition satisfied"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  }
]