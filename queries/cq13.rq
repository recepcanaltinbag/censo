# How many observations are excluded from assessment because their status is unresolved?
# Exercises: UnresolvedObservation subset of NOT assessableAgainst -- the axiom in action

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT (COUNT(?o) AS ?excluded) WHERE {
  ?o a censo:UnresolvedObservation .
  FILTER NOT EXISTS { ?o censo:assessableAgainst ?t }
}
