    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ChemicalIndustry -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ChemicalIndustry">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Industry"/>
