  {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SKOS; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/requiresCompleteGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when every group member must have been measured for the\naggregate to be assessable. If members are missing from the monitoring panel,\nthe aggregate is `censo:IndeterminateCompliance`, not a partial sum. The 24-PFAS\nsum is the obvious case: a survey that measured none of them cannot report\ncompliance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires complete group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AnnualAverageThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Long-term limit (e.g. AA-EQS). Applies to a temporal mean, not\nto a single sample; comparing one grab sample against it is a category error that\nthis class exists to make visible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Annual average threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/prov#Activity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from PROV-O; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/ApplicabilityCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A condition that must hold before a threshold may be applied to an observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Applicability condition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/PreconditionUnmet",
