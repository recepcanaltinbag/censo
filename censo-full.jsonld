  {
    "@id": "https://w3id.org/censo/PossibleExceedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The interval straddles the threshold; the measurement\ncannot decide. A subclass of IndeterminateCompliance recording that the reason\nis the width of the interval, not a defect of the record: unlike the other\nthree, this observation was measured, reported and assessable, and the method\nstill could not answer the question."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Possible exceedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ],
