  {
    "@id": "https://w3id.org/censo/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-08-03"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b1"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "CENSO extends SOSA/SSN with detection and quantification\nlimits, interval-valued results, applicability conditions on regulatory\nthresholds, and a four-valued compliance assessment in which \"cannot be\ndetermined\" is an explicit, queryable outcome. Designed for measurement\nprocesses in which non-detection is the normal result and must be represented as\nan open-world upper bound rather than as zero."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "CENSO: an ontology for censored environmental observations"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "censo"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/censo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://qudt.org/schema/qudt/"
      },
      {
        "@id": "http://www.w3.org/2004/02/skos/core"
      },
      {
        "@id": "http://www.w3.org/ns/prov#"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/"
      },
      {
        "@id": "http://www.w3.org/ns/ssn/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/censo/1.0.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "1.0.0"
      }
    ]
  },
