##############################################################################
#  One observable property, two packages
#
#  owl:sameAs, and this one IS an identity claim: the
#  concentration of a substance in inland surface water is the
#  same observable property whichever regulation names it. This
#  is the reconciliation censo:Analyte's comment promised, and
#  what makes a cross-jurisdiction comparison an entailment.
##############################################################################

cereg:analyte-eu-Thiacloprid owl:sameAs cereg:analyte-tr-Tiakloprid .
