            "@id": "_:nef35d19daf754c299898c1de51e61fb6b22"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b22",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/possiblyExceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitOfDetection",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Lowest concentration reliably distinguishable from a blank.\nBelow it, presence can be neither asserted nor denied. Expressed in\ncenso:limitUnit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit of detection (LOD)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Maximum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "maximum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/RegulationPackage",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A self-contained set of thresholds attributable to one legal\ninstrument at one point in time. Assessment is always relative to a package;\nthere is no such thing as an unqualified compliance verdict.\n\nA package is a censo:Regulation -- the same legal instrument, at the granularity\nat which it is versioned, cited and swapped. Declaring them separate classes\nmade cereg:definesThreshold and censo:definedBy incoherent as inverses, which\nOOPS! reported as a critical pitfall and which is why an individual previously\nhad to be typed as both."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulation package"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b39"
      },
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      },
      {
        "@id": "https://w3id.org/censo/Regulation"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b39",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#minCardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
        "@value": "1"
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/reg/sourceDocument"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/TranscriptionStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How reliably a threshold value was copied from its legal source. Machine-readable so unverified values can be excluded from analysis rather than trusted by default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Transcription status"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/definedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The legal instrument establishing the threshold. Mandatory: an uncited threshold cannot be defended."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "defined by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Regulation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/requiresCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A precondition of the threshold. Unmet preconditions yield no verdict, not a default pass."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/EstimatedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Detected, but between LOD and LOQ, so the reported magnitude\nis indicative only. Reporting it as a point estimate overstates what the method\nsupports. Datasets frequently contain such values presented as if quantified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Estimated observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Procedure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b52",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDisjointClasses"
    ],
    "http://www.w3.org/2002/07/owl#members": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/AnnualAverageThreshold"
          },
          {
            "@id": "https://w3id.org/censo/MaximumAllowableThreshold"
          },
          {
            "@id": "https://w3id.org/censo/ClassBoundaryThreshold"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Assessment",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The act of evaluating observations against one regulation\npackage, producing compliance outcomes. Reified so that the same observations\nassessed under two packages yield two comparable, separately attributable\nresults."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Assessment"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  }
]