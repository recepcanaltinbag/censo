# How many observations fall in each detection status?
# Exercises: censo:CensoredObservation and its three disjoint siblings

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?status (COUNT(?o) AS ?n) WHERE {
  VALUES ?status { censo:CensoredObservation censo:EstimatedObservation
                   censo:QuantifiedObservation censo:UnresolvedObservation }
  ?o a ?status .
} GROUP BY ?status ORDER BY DESC(?n)
