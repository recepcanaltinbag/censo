[
  {
    "@id": "https://w3id.org/censo/Regulation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A dated, versioned legal instrument. Thresholds must cite one, because they change."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/appliesToAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance constrained. Group thresholds use cereg:appliesToGroup instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/LimitWithinUncertaintyBand",
    "@type": [
      "https://w3id.org/censo/AssessmentFlag"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A censored result whose quantification limit clears the\nstandard, T − U < LOQ ≤ T. Article 3(3b) compares the limit with the standard\nas a point, and the verdict is Compliant; a measured value at the same level\nwould be PossibleExceedance. The flag keeps that difference visible without\nmaking the metrological reading the legal one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit within the uncertainty band"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/transposes",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "National package implementing a supranational one, e.g. YSKY transposing the EU EQS Directive. Divergences between the two are meaningful and queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transposes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b35",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Compliant"
      }
    ],
    "http://www.w3.org/2002/07/owl#intersectionOf": [
      {
        "@list": [
          {
            "@id": "http://www.w3.org/ns/sosa/Observation"
          },
          {
            "@id": "_:n9c2359741e844e67842041d1ef838e94b36"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b36",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/belowThreshold"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Exceedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Exceedance is established: it holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Exceedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/transcriptionStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether a value has been verified against the primary legal\ntext. Machine-readable so that unverified values can be excluded from analysis\nrather than trusted by default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/TranscriptionStatus"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/definedBy",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The legal instrument establishing the threshold. Mandatory: an uncited threshold cannot be defended."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "defined by"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Regulation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/CensoredResultRule",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A way of comparing a censored result with a standard."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Censored result rule"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/duringCampaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The sampling campaign the observation belongs to; part of the observation's identity key."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "during campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Campaign"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/VerifiedAgainstPrimarySource",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "verified against primary source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/SubstanceGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A set of analytes assessed collectively, e.g. 'pesticides total', 'sum of 24 PFAS'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Substance group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/2004/02/skos/core#Concept"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/ObservableProperty",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Observable property"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/RegulatoryDefaultUncertainty",
    "@type": [
      "https://w3id.org/censo/UncertaintySource"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The largest uncertainty the law permits a method to have, applied because the record reports none."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "regulation package default"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/resultUpperBound",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Largest concentration consistent with the observation; the LOD when censored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "result upper bound"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b31",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/PossibleExceedance"
      }
    ],
    "http://www.w3.org/2002/07/owl#intersectionOf": [
      {
        "@list": [
          {
            "@id": "http://www.w3.org/ns/sosa/Observation"
          },
          {
            "@id": "_:n9c2359741e844e67842041d1ef838e94b32"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b32",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/possiblyExceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "http://qudt.org/schema/qudt/Unit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from QUDT; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/covariateMinimum",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Inclusive lower end of the covariate range over which the condition holds, in censo:covariateUnit. Annex I's cadmium class 2 is '40 to < 50 mg CaCO3/l': minimum 40."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "covariate minimum"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/expandedUncertainty",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Half-width U (coverage factor k = 2) at the level of the\nthreshold, in the unit of the result, with which the verdict on this observation\nwas drawn. It relates to qudt:standardUncertainty u as U = k·u. A reported\nuncertainty stated at another concentration is not converted: it is replaced by\nthe regulatory default, and censo:uncertaintySource says so."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "expanded uncertainty"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/2004/02/skos/core#Concept",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SKOS; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Concept"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/resultLowerBound",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Smallest concentration consistent with the observation; 0 when censored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "result lower bound"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "https://www.w3.org/TR/xmlschema11-2/#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/requiresCovariate",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An observable property that must be co-measured for the condition to be evaluable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires covariate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservableProperty"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AssessmentFlag",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A verdict-neutral annotation on an assessment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Assessment flag"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/hasAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance this observation is about; exactly one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/ToxicEquivalentSum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Potency-weighted sum, as used for dioxin-like compounds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "toxic equivalent sum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitDefinition",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How the source defines the limit it reports, in its own\nwords -- a method detection level, a laboratory reporting level, a practical\nquantitation limit. Definitions differ (a multiple of a blank standard\ndeviation, a signal-to-noise ratio, the lowest calibration standard) and are\nnot converted into one another. The verdict does not depend on it: the upper\nbound of a censored result is the limit reported, whatever its definition. What\nit makes visible is a definition changing at one station."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit definition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitUnit",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Unit of LOD and LOQ. Mandatory: a bare limit is not comparable to anything."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://qudt.org/schema/qudt/Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/thresholdValue",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The numeric limit, meaningful only with its unit and applicability conditions."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "threshold value"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/TranscribedFromSecondarySource",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Taken from a project spreadsheet, report or database rather than the legal text. Treat as provisional."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcribed from secondary source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/aggregationFunction",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Function used to combine group members, e.g. sum for the 24-PFAS standard."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "aggregation function"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/AggregationFunction"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/",
    "@type": [
      "http://www.w3.org/2002/07/owl#Ontology"
    ],
    "http://purl.org/dc/terms/created": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#date",
        "@value": "2026-08-03"
      }
    ],
    "http://purl.org/dc/terms/creator": [
      {
        "@id": "_:n9c2359741e844e67842041d1ef838e94b1"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "CENSO extends SOSA/SSN with detection and quantification\nlimits, interval-valued results, applicability conditions on regulatory\nthresholds, and a three-valued compliance assessment in which \"cannot be\ndetermined\" is an explicit, queryable outcome, subtyped by the reason it cannot. Designed for measurement\nprocesses in which non-detection is the normal result and must be represented as\nan open-world upper bound rather than as zero."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "CENSO: an ontology for censored environmental observations"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespacePrefix": [
      {
        "@value": "censo"
      }
    ],
    "http://purl.org/vocab/vann/preferredNamespaceUri": [
      {
        "@value": "https://w3id.org/censo/"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@id": "http://qudt.org/schema/qudt/"
      },
      {
        "@id": "http://www.w3.org/2004/02/skos/core"
      },
      {
        "@id": "http://www.w3.org/ns/prov#"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/"
      },
      {
        "@id": "http://www.w3.org/ns/ssn/"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionIRI": [
      {
        "@id": "https://w3id.org/censo/2.4.0"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "2.4.0"
      }
    ]
  },
  {
    "@id": "_:n9c2359741e844e67842041d1ef838e94b1",
    "@type": [
      "http://xmlns.com/foaf/0.1/Person"
    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Recep Can Altınbağ"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AnalyticalMethod",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A procedure determining the concentration of an analyte,\ncharacterised by a limit of detection and a limit of quantification. The limits\nbelong to the METHOD, not to the substance: the same analyte may be censored at\none laboratory and quantified at another. Attaching limits to the analyte — the\ncommon shortcut — makes cross-laboratory comparison unsound."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Analytical method"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Procedure"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "A sosa:Procedure with a detection limit."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/DetectedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The analyte was found, whether or not it could be quantified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Detected observation"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/censo/CensoredObservation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/EstimatedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Detected, but between LOD and LOQ, so the reported magnitude\nis indicative only. Reporting it as a point estimate overstates what the method\nsupports. Datasets frequently contain such values presented as if quantified.\n\nDECLARED AND NEVER POPULATED FROM WISE-6, which is a finding rather than an\noversight. The release has one below-limit flag and no field distinguishing\n\"sought and not found\" from \"found and not quantifiable\", so both arrive as\ncenso:CensoredObservation and this class stays empty. The vocabulary can carry\nthe distinction; this record cannot supply it.\n\nPOPULATED FROM A RECORD THAT CAN SUPPLY IT. The US Water Quality Portal\nrecords a detection condition on each result, and a laboratory comment where\nthe condition is left blank; derived/abox/censo-wqp.ttl carries every estimated\nresult of a California slice (scripts/31_wqp_estimated.py). No result there\ncarries both limits, so the closed interval [LOD, LOQ] is written as far as the\nrecord supplies it.\n\nAND NOT THE HOME FOR AN UNFLAGGED MEAN BELOW ITS OWN LIMIT. Waterbase contains\nannual means reported as quantified with a value below their quantification\nlimit. Until 2.4.0 they were censo:BoundNotEstablished, read as a record\ncontradicting itself. Directive 2009/90/EC, Article 5(2), settles what they are:\n\"where a calculated mean value ... is below the limits of quantification, the\nvalue shall be referred to as 'less than limit of quantification'\". They are\ncensored results bounded by the limit, typed censo:CensoredObservation and\nflagged censo:MeanBelowOwnLimit -- not estimated, because nothing in the record\nsays the substance was detected."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Estimated observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      },
      {
        "@id": "https://w3id.org/censo/AssessedObservation"
      },
      {
        "@id": "https://w3id.org/censo/DetectedObservation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/appliesToGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance group whose aggregate the threshold constrains."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Procedure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/PreconditionUnmet",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (c): a required applicability condition is not satisfied."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Precondition unmet"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/conditionScreened",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The condition was NOT evaluated, and the verdict holds\nanyway because it is the same for every value the condition could take. That is\na screening step, and it is recorded as one: censo:conditionSatisfied would\nclaim the record supplies what the condition needs, which it does not.\n\nThe case this exists for is the first tier of the Commission's guidance on\nmetal standards: a bioavailable concentration cannot exceed the dissolved one,\nso a dissolved result that clears the bioavailable standard clears it whatever\nthe bioavailability model would say, and a result below a quantification limit\nabove the standard is set aside by Article 3(3b) either way. A reader can ask\nthe graph which verdicts rest on a screen rather than on an evaluated\ncondition, and the rule layer stops short of censo:PreconditionUnmet for\nexactly these."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "condition screened"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/UncertaintySource",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Where the uncertainty a verdict was drawn with came from."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Uncertainty source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/thresholdUnit",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Unit of the threshold; must be commensurable with the observation unit before comparison."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "threshold unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://qudt.org/schema/qudt/Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/ComplianceOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The verdict of comparing an observation against a threshold.\nTHREE-valued: the standard is met, it is not met, or compliance cannot be\ndetermined. The three are what the Directive itself admits, and the third is\nwhat closed-world models cannot express. The reason a verdict cannot be\ndetermined is carried by the subclasses of IndeterminateCompliance rather than\nby a fourth top value, which would assert a distinction the Directive does not\nmake."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compliance outcome"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MeanBelowOwnLimit",
    "@type": [
      "https://w3id.org/censo/AssessmentFlag"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reported as quantified with a value below its quantification limit, and read as a censored result under Directive 2009/90/EC, Article 5(2). The reported number is kept as censo:reportedValue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unflagged mean below its own limit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Campaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bounded sampling exercise. Making it explicit lets the same station be compared across time and prevents campaigns being conflated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sampling campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/FeatureOfInterest",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Feature of interest"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Observation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Observation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/legalReference",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Citation as published, e.g. 'OJ L 348, 24.12.2008' or 'Resmî Gazete 28483'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "legal reference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/assessableAgainst",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when EVERY condition the threshold requires is\nsatisfied for this observation. Only then may a verdict be drawn. Universal\nquantification over a materialised set is a closed-world check, so it lives in\nSHACL, not in OWL."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessable against"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/PointComparison",
    "@type": [
      "https://w3id.org/censo/reg/CensoredResultRule"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The limit is compared with the standard as a point: Compliant\nif it does not exceed it, MethodInsufficient if it does. This is Article 3(3b)\nof Directive 2008/105/EC, and the EU package's rule."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "point comparison"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Compliant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Compliance is established: it holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compliant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/possiblyExceeds",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultLowerBound <= thresholdValue < resultUpperBound: the interval straddles the limit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "possibly exceeds"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ],
    "http://www.w3.org/2002/07/owl#propertyDisjointWith": [
      {
        "@id": "https://w3id.org/censo/belowThreshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/PossibleExceedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The interval straddles the threshold; the measurement\ncannot decide. A subclass of IndeterminateCompliance recording that the reason\nis the width of the interval, not a defect of the record: unlike the other\nthree, this observation was measured, reported and assessable, and the method\nstill could not answer the question."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Possible exceedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Unverified",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unverified"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/IndeterminateCompliance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "No compliance statement is supportable. The third of the\nthree outcomes the Directive admits, and the only one a two-valued schema has\nnowhere to put. It is ABSTRACT in practice: every instance carries one of the\nsubclasses below, which record WHY no statement is supportable —\n\n(a) NoThresholdDefined  — the regulation sets no limit for this analyte here;\n(b) MethodInsufficient  — the observation is censored and the method's LOQ\n    exceeds the threshold, so compliance cannot be demonstrated even in\n    principle;\n(c) PreconditionUnmet   — a precondition is unmet: unknown fraction, missing\n    bioavailability covariates, unknown hardness class;\n(d) PossibleExceedance  — the result was measured and assessable, and its\n    interval straddles the limit, so the method cannot decide either way;\n(e) BoundNotEstablished — the record states no bound to compare at all;\n(f) CensoredAmbiguous   — censored with the threshold inside [0, LOD], the\n    narrower case at the DETECTION limit, which no monitoring release states.\n\nCase (b) is the sharpest: a laboratory can report \"not detected\" for a substance\nwhose LOQ is a hundredfold above the legal limit, and a closed-world system\nrecords that as compliance.\n\nPRECEDENCE. A censored result whose LOQ exceeds the threshold has an interval\nthat straddles it too, so (b) and (d) both describe it. Article 3(3b) is\ndecisive — the result \"shall not be considered\" — and such an observation is\nrecorded under MethodInsufficient. This is a rule-layer priority and NOT an\nowl:disjointWith axiom between the two: the same observation may legitimately be\nMethodInsufficient against one jurisdiction's standard and PossibleExceedance\nagainst another's, and class-level disjointness would forbid the two-regulation\nassessment this vocabulary exists to support. Exclusivity lives where it always\nhas, on the comparison properties, per observation-threshold pair.\n\nNOTE ON INFERENCE. This class cannot be defined as \"neither of the other two\",\nbecause under the open-world assumption an unasserted property is not a false\none. It is materialised under a locally closed world; see censo-shapes.ttl."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Indeterminate compliance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Imidacloprid measured by a method quantifying at 2.065 µg/L against an EU annual-average standard of 0.0068 µg/L: no result the method could return would decide compliance."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/UncertaintyAboveLegalMaximum",
    "@type": [
      "https://w3id.org/censo/AssessmentFlag"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A reported expanded uncertainty above 0.5 T: the reported value is used, and the method fails Directive 2009/90/EC, Article 4(1)."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "reported uncertainty above the legal maximum"
      }
    ]
  },
