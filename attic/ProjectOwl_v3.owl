    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CE -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CE">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#MassSpectralLibrary"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CES -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CES">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#MassSpectralLibrary"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CXP -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CXP">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#MrmInformation"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CalibrationCurve -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CalibrationCurve">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#PollutantFeature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Catchment -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Catchment">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Polygon"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#feature"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentFeature"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#has"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#RiverSegment"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#isPartOf"/>
                <owl:allValuesFrom rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Watershed"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentArea -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentArea">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentFeature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentFeature -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#CatchmentFeature">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Feature"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ChemicalFeatures -->

