    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "en",
        "@value": "Vocabulary for expressing environmental quality\nstandards as self-contained, versioned, swappable modules, including group and\nderived thresholds such as a total-pesticide sum."
      }
    ],
    "http://purl.org/dc/terms/license": [
      {
        "@id": "https://creativecommons.org/licenses/by/4.0/"
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "en",
        "@value": "CENSO-REG: pluggable regulation packages for censored observations"
      }
    ],
