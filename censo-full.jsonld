    ],
    "http://xmlns.com/foaf/0.1/name": [
      {
        "@value": "Recep Can Altınbağ"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/PossibleExceedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The interval straddles the threshold; the measurement cannot decide."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Possible exceedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ],
