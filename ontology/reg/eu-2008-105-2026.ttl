##############################################################################
#  The matrix this package's thresholds apply to
##############################################################################

cereg:eu-2008-105-2026-cond-matrix a censo:MatrixCondition ;
    rdfs:label "inland surface water (Annex I, column 1)"@en ;
    rdfs:comment "Annex I sets four values per substance: an annual average and a maximum allowable concentration, each for inland surface waters and for other surface waters. Inland surface waters are rivers and lakes and the artificial or heavily modified bodies related to them. The two matrices differ -- benzene is 10 ug/L inland and 8 elsewhere -- so a threshold that does not say which water it governs cannot be applied. The inland values are emitted, the other surface water values are parsed and verified by scripts/10_parse_eu_eqs.py and not emitted, and this condition records which of the two this package carries."@en .

##############################################################################
#  Applicability conditions this package's thresholds carry
#
#  Each is quoted from the Annex I footnote that creates it.
#  Where the record cannot supply the covariates a condition
#  names, the outcome is censo:PreconditionUnmet -- not a
#  default pass, and not a comparison against a number that
#  refers to a different quantity.
##############################################################################

cereg:eu-2008-105-2026-cond-bioavailability a censo:BioavailabilityCondition ;
    rdfs:label "bioavailability condition (eu-2008-105-2026)"@en ;
    censo:requiresCovariate cereg:covariate-hardness ;
    censo:requiresCovariate cereg:covariate-dissolvedOrganicCarbon ;
    censo:requiresCovariate cereg:covariate-pH ;
    rdfs:comment "Annex I footnote 12: these EQS refer to bioavailable concentrations of the substances, which requires hardness, dissolved organic carbon and pH for normalisation."@en .

cereg:eu-2008-105-2026-cond-hardness-class a censo:HardnessClassCondition ;
    rdfs:label "hardness class condition (eu-2008-105-2026)"@en ;
    censo:requiresCovariate cereg:covariate-hardness ;
    rdfs:comment "Annex I footnote 9: the EQS values vary with water hardness over five class categories, so the applicable value is unknown until the hardness is measured."@en .

cereg:covariate-dissolvedOrganicCarbon a sosa:ObservableProperty ;
    rdfs:label "dissolvedOrganicCarbon"@en .

cereg:covariate-hardness a sosa:ObservableProperty ;
    rdfs:label "hardness"@en .

cereg:covariate-pH a sosa:ObservableProperty ;
    rdfs:label "pH"@en .

