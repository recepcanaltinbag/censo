# Which analytes have no published detection limit, so their zeros cannot be interpreted?
# Exercises: censo:UnresolvedObservation; absence of censo:AnalyticalMethod

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?analyteLabel (COUNT(?o) AS ?n) WHERE {
  ?o a censo:UnresolvedObservation ; censo:hasAnalyte ?a .
  ?a rdfs:label ?analyteLabel .
} GROUP BY ?analyteLabel ORDER BY DESC(?n) LIMIT 20
