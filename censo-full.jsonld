      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/BoundNotEstablished",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (e): the record establishes no bound to compare against\nthe threshold. Either nothing says whether the number is a measurement — neither\na censoring flag nor a limit is reported, so no interval can be built — or the\nnumber contradicts the limit reported beside it. The distinction from\nMethodInsufficient matters: there the bound is known and known to be too wide,\nhere there is no bound at all, and the two call for different repairs."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bound not established"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
