# What interval does a given observation establish, and from which limit?
# Exercises: censo:resultLowerBound / resultUpperBound bound to the method.
# The bound asked for is the QUANTIFICATION limit: it is the one the record
# states, and it is the one the upper bound of a non-detection is set from.

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?o ?reported ?lo ?hi ?loq WHERE {
  ?o a censo:CensoredObservation ;
     censo:reportedValue ?reported ;
     censo:resultLowerBound ?lo ;
     censo:resultUpperBound ?hi ;
     sosa:usedProcedure ?m .
  ?m censo:limitOfQuantification ?loq .
} LIMIT 10
