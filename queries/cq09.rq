# How does detection frequency vary between campaigns for a substance?
# Exercises: censo:duringCampaign -- seasonality of detection

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?campaign (COUNT(?o) AS ?detected) WHERE {
  ?o a censo:DetectedObservation ; censo:duringCampaign ?c .
  ?c rdfs:label ?campaign .
} GROUP BY ?campaign ORDER BY ?campaign
