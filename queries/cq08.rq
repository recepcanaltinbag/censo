# Which substances were never quantified anywhere in the survey, despite being measured?
# Exercises: censo:QuantifiedObservation absent for the analyte

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?analyteLabel WHERE {
  ?a a censo:Analyte ; rdfs:label ?analyteLabel .
  FILTER EXISTS { ?o censo:hasAnalyte ?a }
  FILTER NOT EXISTS { ?q a censo:QuantifiedObservation ; censo:hasAnalyte ?a }
} ORDER BY ?analyteLabel LIMIT 25
