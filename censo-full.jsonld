      {
        "@id": "https://w3id.org/censo/exceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/calibrationR2",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "R² of the calibration curve; a quality indicator for the reported limits."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "calibration coefficient of determination"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/ObservableProperty",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Observable property"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/resultUpperBound",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Largest concentration consistent with the observation; the LOD when censored."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "result upper bound"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/prov#wasDerivedFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from PROV-O; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "was derived from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/legalReference",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Citation as published, e.g. 'OJ L 348, 24.12.2008' or 'Resmî Gazete 28483'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "legal reference"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/UnresolvedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Made, but its detection status cannot be established, typically\nbecause the applicable LOD/LOQ for the analyte-method pair is unknown. Such\nobservations are structurally undecidable and must be excluded from inference\nrather than silently treated as quantified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unresolved observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:n548f7943ee434a00809e2b8f87dc431eb25"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ]
  },
  {
    "@id": "_:n548f7943ee434a00809e2b8f87dc431eb25",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#complementOf": [
      {
        "@id": "_:n548f7943ee434a00809e2b8f87dc431eb26"
      }
    ]
  },
  {
    "@id": "_:n548f7943ee434a00809e2b8f87dc431eb26",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Procedure",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Procedure"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/ComplianceOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The verdict of comparing an observation against a threshold.\nTHREE-valued: the standard is met, it is not met, or compliance cannot be\ndetermined. The three are what the Directive itself admits, and the third is\nwhat closed-world models cannot express. The reason a verdict cannot be\ndetermined is carried by the subclasses of IndeterminateCompliance rather than\nby a fourth top value, which would assert a distinction the Directive does not\nmake."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compliance outcome"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:n548f7943ee434a00809e2b8f87dc431eb30"
      }
    ]
  },
  {
    "@id": "_:n548f7943ee434a00809e2b8f87dc431eb30",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/Exceedance"
          },
          {
            "@id": "https://w3id.org/censo/Compliant"
          },
          {
            "@id": "https://w3id.org/censo/IndeterminateCompliance"
          }
        ]
      }
    ]
  },
  {
    "@id": "http://xmlns.com/foaf/0.1/Person",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from FOAF; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Person"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/ArithmeticMean",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "arithmetic mean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/appliesToAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance constrained. Group thresholds use cereg:appliesToGroup instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/appliesToGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance group whose aggregate the threshold constrains."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/censoringRecovered",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when the detection status was RECONSTRUCTED after the\nfact, typically because the source recorded a non-detection as 0 and the status\nwas recovered by joining the analyte's LOD. Such observations carry an extra\nassumption and must remain distinguishable from those whose censoring was\nrecorded at source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "censoring recovered"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Campaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bounded sampling exercise. Making it explicit lets the same station be compared across time and prevents campaigns being conflated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sampling campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Regulation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A dated, versioned legal instrument. Thresholds must cite one, because they change."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Regulation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/transposes",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "National package implementing a supranational one, e.g. YSKY transposing the EU EQS Directive. Divergences between the two are meaningful and queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transposes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/HardnessClassCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The threshold varies by water hardness class, as for cadmium.\nWithout a hardness measurement the applicable class — and therefore the\napplicable threshold — is unknown."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Hardness class condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/inForceFrom",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Date of entry into force. Observations predating it can still be assessed against the package, but the result is counterfactual and must be labelled as such."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "in force from"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/QuantifiedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Detected at or above the limit of quantification; the magnitude is usable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Quantified observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/belowThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultUpperBound <= thresholdValue."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "below threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
