##############################################################################
#  Vocabulary individuals this package uses
##############################################################################

cereg:VerifiedAgainstPrimarySource a cereg:TranscriptionStatus ;
    rdfs:label "verified against the primary source"@en ;
    rdfs:comment "The value was parsed from the primary legal text by a script in this repository, not taken from a secondary compilation."@en .

##############################################################################
#  The matrix this package's thresholds apply to
##############################################################################

cereg:tr-ysky-2016-cond-matrix a censo:MatrixCondition ;
    rdfs:label "inland surface water, rivers (Table 4, YSKY 2016)"@en ;
    rdfs:comment "Table 4 sets separate columns for rivers and for coastal and transitional waters. The values emitted here are the river columns, so every threshold in this package applies to river water and to nothing else. The coastal columns are parsed and verified by scripts/08_verify_thresholds.py and not emitted, because the record this work assesses is river water; emitting a value without saying which water it governs is the failure this vocabulary exists to prevent."@en .

