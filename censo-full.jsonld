[
  {
    "@id": "https://w3id.org/censo/ClassBoundaryThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Boundary between water quality classes. Conventional\ndeterminands such as COD, ammonium and phosphate are assessed against these, not\nagainst an EQS — a distinction routinely lost when both are stored as a single\n\"limit\" column."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Class boundary threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/exceeds",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultLowerBound > thresholdValue: exceedance holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "exceeds"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/derivedFromRecord",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links an observation to the source file, sheet and cell it was extracted from, so every assertion is traceable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "derived from record"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#wasDerivedFrom"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitUnit",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Unit of LOD and LOQ. Mandatory: a bare limit is not comparable to anything."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit unit"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://qudt.org/schema/qudt/Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/conditionSatisfied",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised by the rule layer when the observation demonstrably meets the condition."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "condition satisfied"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/BioavailabilityCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The threshold is a bioavailable concentration (as for nickel,\nlead, copper and zinc under EU EQS) and requires hardness, dissolved organic\ncarbon and pH for normalisation. Absent those covariates, no compliance\nstatement is possible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Bioavailability condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/producedByRun",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Links a result to the analytical run that produced it, and so to the limits actually in force for that measurement."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "produced by run"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/AnalyticalRun"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/hasAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance this observation is about; exactly one."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "has analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/DetectedObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The analyte was found, whether or not it could be quantified."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Detected observation"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/censo/CensoredObservation"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b10"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b10",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/EstimatedObservation"
          },
          {
            "@id": "https://w3id.org/censo/QuantifiedObservation"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/assessableAgainst",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when EVERY condition the threshold requires is\nsatisfied for this observation. Only then may a verdict be drawn. Universal\nquantification over a materialised set is a closed-world check, so it lives in\nSHACL, not in OWL."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "assessable against"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/FractionCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Restricts the threshold to an analytical fraction, typically\nDISSOLVED for metals. Comparing a total-metal measurement against a\ndissolved-fraction threshold is invalid; where the fraction is unrecorded, the\nassessment is undecidable rather than conservative."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Fraction condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/censoringRecovered",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when the detection status was RECONSTRUCTED after the\nfact, typically because the source recorded a non-detection as 0 and the status\nwas recovered by joining the analyte's LOD. Such observations carry an extra\nassumption and must remain distinguishable from those whose censoring was\nrecorded at source."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "censoring recovered"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/transposes",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "National package implementing a supranational one, e.g. YSKY transposing the EU EQS Directive. Divergences between the two are meaningful and queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transposes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/IndeterminateCompliance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "No compliance statement is supportable. Arises when\n(a) no threshold exists for the analyte in this matrix;\n(b) the method's LOQ exceeds the threshold, so compliance cannot be demonstrated\n    even in principle;\n(c) a precondition is unmet — unknown fraction, missing bioavailability\n    covariates, unknown hardness class;\n(d) the observation is censored and the threshold lies inside [0, LOD].\n\nCase (b) is the sharpest: a laboratory can report \"not detected\" for a substance\nwhose LOQ is a hundredfold above the legal limit, and a closed-world system\nrecords that as compliance.\n\nNOTE ON INFERENCE. This class cannot be defined as \"none of the other three\",\nbecause under the open-world assumption an unasserted property is not a false\none. It is materialised under a locally closed world; see censo-shapes.ttl."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Indeterminate compliance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Imidacloprid measured by a method quantifying at 2.065 µg/L against an EU annual-average standard of 0.0068 µg/L: no result the method could return would decide compliance."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Campaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A bounded sampling exercise. Making it explicit lets the same station be compared across time and prevents campaigns being conflated."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sampling campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/ToxicEquivalentSum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Potency-weighted sum, as used for dioxin-like compounds."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "toxic equivalent sum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/complianceDeadline",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Date by which member states or operators must meet the standards; may be long after entry into force."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "compliance deadline"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#date"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/sourceDocument",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Dereferenceable URI of the legal text the values were transcribed from. Required: a threshold without a traceable source is not usable in a regulatory context."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "source document"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/prov#Entity"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "http://www.w3.org/ns/prov#hadPrimarySource"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/VerifiedAgainstPrimarySource",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "verified against primary source"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/NoThresholdDefined",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (a): the regulation sets no limit for this analyte in this matrix."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "No threshold defined"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Sum",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "sum"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/GroupThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A threshold applying to an aggregate over a substance group rather than to one analyte."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Group threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b30"
      },
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b31"
      },
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b30",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onClass": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/reg/appliesToGroup"
      }
    ],
    "http://www.w3.org/2002/07/owl#qualifiedCardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
        "@value": "1"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b31",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onClass": [
      {
        "@id": "https://w3id.org/censo/reg/AggregationFunction"
      }
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/reg/aggregationFunction"
      }
    ],
    "http://www.w3.org/2002/07/owl#qualifiedCardinality": [
      {
        "@type": "http://www.w3.org/2001/XMLSchema#nonNegativeInteger",
        "@value": "1"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/regulationVersion",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Amendment identifier, so thresholds of different vintages stay distinguishable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Regulation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "regulation version"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/calibrationSlope",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Slope of the calibration curve, from which LOD and LOQ are derived."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "calibration slope"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "http://qudt.org/schema/qudt/Unit",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from QUDT; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Unit"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/TranscribedFromSecondarySource",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Taken from a project spreadsheet, report or database rather than the legal text. Treat as provisional."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcribed from secondary source"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/FeatureOfInterest",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Feature of interest"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AnnualAverageThreshold",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Long-term limit (e.g. AA-EQS). Applies to a temporal mean, not\nto a single sample; comparing one grab sample against it is a category error that\nthis class exists to make visible."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Annual average threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/memberOfGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Membership in a collectively assessed set. Group membership is curated knowledge with provenance, not a spreadsheet column."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "member of group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/metaboliteOf",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Degradation or transformation product. Relevant because a\nsurvey may measure a metabolite while the regulated parent is absent from the\npanel, or vice versa. The 2026 EU update explicitly brings non-relevant\npesticide metabolites into scope, so this relation carries legal weight."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "metabolite of"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#seeAlso": [
      {
        "@language": "en",
        "@value": "Transitive: a transformation product of a transformation product is still one of the parent. NOT symmetric, despite the scanner's suggestion -- the relation has a direction."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "1-Hydroxyibuprofen metaboliteOf Ibuprofen."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Exceedance",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Exceedance is established: it holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Exceedance"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b17"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b17",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#intersectionOf": [
      {
        "@list": [
          {
            "@id": "http://www.w3.org/ns/sosa/Observation"
          },
          {
            "@id": "_:nef35d19daf754c299898c1de51e61fb6b18"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b18",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/exceeds"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/CensoredAmbiguous",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Case (d): the observation is censored and the threshold lies within [0, LOD], so non-detection is compatible with both compliance and exceedance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Censored ambiguous"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Analyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A substance whose concentration is the observed property.\nAligned to ChEBI/PubChem with skos:exactMatch rather than renamed, so that two\nregulation packages referring to the same substance resolve to one IRI — the\nprecondition for comparing them."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservableProperty"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MatrixCondition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Restricts the threshold to a matrix: inland surface water, coastal water, biota, sediment."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Matrix condition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/limitOfQuantification",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Lowest concentration measurable with stated accuracy and precision."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "limit of quantification (LOQ)"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/sosa/Sample",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from SOSA; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Sample"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b46",
    "@type": [
      "http://www.w3.org/2002/07/owl#AllDisjointClasses"
    ],
    "http://www.w3.org/2002/07/owl#members": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/reg/RegulationPackage"
          },
          {
            "@id": "https://w3id.org/censo/reg/SubstanceGroup"
          },
          {
            "@id": "https://w3id.org/censo/reg/Assessment"
          },
          {
            "@id": "https://w3id.org/censo/reg/AggregationFunction"
          },
          {
            "@id": "https://w3id.org/censo/reg/TranscriptionStatus"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/requiresCovariate",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An observable property that must be co-measured for the condition to be evaluable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/ApplicabilityCondition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires covariate"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/sosa/ObservableProperty"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/possiblyExceeds",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Materialised when resultLowerBound <= thresholdValue < resultUpperBound: the interval straddles the limit."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "possibly exceeds"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/Compliant",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Compliance is established: it holds for every value consistent with the observation."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compliant"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/ComplianceOutcome"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b13"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b13",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#intersectionOf": [
      {
        "@list": [
          {
            "@id": "http://www.w3.org/ns/sosa/Observation"
          },
          {
            "@id": "_:nef35d19daf754c299898c1de51e61fb6b14"
          }
        ]
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b14",
    "@type": [
      "http://www.w3.org/2002/07/owl#Restriction"
    ],
    "http://www.w3.org/2002/07/owl#onProperty": [
      {
        "@id": "https://w3id.org/censo/belowThreshold"
      }
    ],
    "http://www.w3.org/2002/07/owl#someValuesFrom": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/analysedSample",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The physical sample analysed. Reuses sosa:Sample so the sampling chain stays in the standard vocabulary."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/AnalyticalRun"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "analysed sample"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/ns/sosa/Sample"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/NotCoveredBySurvey",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The regulation defines a threshold for an analyte the\nmonitoring programme never measured. Under a closed-world model this is\ninvisible; here it is an explicit verdict, which is what makes \"assess a 2018\nsurvey under a 2026 regulation\" a well-posed question."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Not covered by survey"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/IndeterminateCompliance"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "A survey that measured none of the 24 PFAS named by the 2026 standard cannot report compliance with their sum; the aggregate is not assessable rather than zero."
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/AnalyticalRun",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "One execution of an analytical method on a batch of samples,\ncarrying its own calibration curve and therefore its own detection limits. Two\nobservations of the same analyte are only strictly comparable when they share a\nrun, or when the runs' limits are known and comparable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Analytical run"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "http://www.w3.org/ns/prov#Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/casNumber",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Preferred join key across heterogeneous sources; more reliable than trade or trivial names."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "CAS registry number"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#string"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/prov#Activity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from PROV-O; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Activity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/supersedes",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty",
      "http://www.w3.org/2002/07/owl#TransitiveProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Names the package this one replaces. Transitive, so the full amendment chain is queryable."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "supersedes"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/RegulationPackage"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/CensoredObservation",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The analyte was sought and not detected. Asserts only that the\ntrue concentration lies in [0, LOD]. It does NOT assert absence. Storing such an\nobservation as 0 destroys the distinction and biases every derived aggregate\ndownwards."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Censored observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b27"
      },
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b28"
      },
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "en",
        "@value": "Observation whose result is below the method's limit of detection."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#example": [
      {
        "@language": "en",
        "@value": "Atrazine sought and not detected by a method whose limit of detection is 0.02 µg/L: the concentration lies in [0, 0.02], which is not the same claim as zero."
      }
    ]
  },
