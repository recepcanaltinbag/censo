      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reportingYear",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty",
      "http://www.w3.org/2002/07/owl#FunctionalProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The year a campaign reports for, as data rather than as a\nsubstring of the campaign's identifier.\n\nWithout it a temporal question can only be answered by parsing an IRI, which is\nthe same defect this vocabulary objects to elsewhere: a fact that a reader can\nsee but a query cannot reach. Whether a finding holds in the most recent years\nor only in the archive is not a footnote to a compliance record --- it is what\nseparates a historical artefact from a live problem --- so the record has to be\nable to answer it.\n\nFunctional: a campaign reports for exactly one year."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "reporting year"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#gYear"
      }
    ]
  },
