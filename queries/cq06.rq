# Which thresholds have not been verified against the primary legal text?
# Exercises: cereg:transcriptionStatus -- unverified values must not enter analysis

PREFIX censo: <https://w3id.org/censo/>
PREFIX cereg: <https://w3id.org/censo/reg/>
PREFIX sosa:  <http://www.w3.org/ns/sosa/>
PREFIX rdfs:  <http://www.w3.org/2000/01/rdf-schema#>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>
PREFIX skos:  <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:   <http://www.opengis.net/ont/geosparql#>

SELECT ?status (COUNT(?t) AS ?n) WHERE {
  ?t a censo:Threshold ; cereg:transcriptionStatus ?status .
} GROUP BY ?status
