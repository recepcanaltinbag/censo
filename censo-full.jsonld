      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subPropertyOf": [
      {
        "@id": "https://w3id.org/censo/assessableAgainst"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/ComplianceOutcome",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The verdict of comparing an observation against a threshold.\nFour-valued; the fourth value is what closed-world models cannot express."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Compliance outcome"
      }
    ],
    "http://www.w3.org/2002/07/owl#equivalentClass": [
      {
        "@id": "_:nef35d19daf754c299898c1de51e61fb6b32"
      }
    ]
  },
  {
    "@id": "_:nef35d19daf754c299898c1de51e61fb6b32",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2002/07/owl#unionOf": [
      {
        "@list": [
          {
            "@id": "https://w3id.org/censo/Exceedance"
          },
          {
            "@id": "https://w3id.org/censo/PossibleExceedance"
          },
          {
            "@id": "https://w3id.org/censo/Compliant"
          },
          {
            "@id": "https://w3id.org/censo/IndeterminateCompliance"
          }
        ]
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/transcriptionStatus",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Whether a value has been verified against the primary legal\ntext. Machine-readable so that unverified values can be excluded from analysis\nrather than trusted by default."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "transcription status"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/TranscriptionStatus"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Unverified",
    "@type": [
      "https://w3id.org/censo/reg/TranscriptionStatus"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "unverified"
      }
    ]
  },
  {
    "@id": "http://www.w3.org/ns/prov#Entity",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Reused from PROV-O; declared here only so that this standalone distribution is self-describing."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Entity"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/RelevantMetabolite",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Metabolite retaining the pesticidal activity of its parent; assessed as a pesticide."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Relevant metabolite"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ],
    "http://www.w3.org/2002/07/owl#disjointWith": [
      {
        "@id": "https://w3id.org/censo/reg/NonRelevantMetabolite"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/AggregationFunction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "How the members of a substance group are combined into the single quantity the threshold applies to."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Aggregation function"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/MassSpectrometryTransition",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "An LC-MS/MS multiple-reaction-monitoring transition —\nprecursor and product ion, retention time and the voltages that select them.\nIt identifies the measurement channel that produced a result, and hence which\ndetection limit applies. This is the level at which analytical provenance\nactually lives, and it is absent from every water ontology surveyed."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Mass spectrometry transition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/AnalyticalMethod"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/duringCampaign",
    "@type": [
      "http://www.w3.org/2002/07/owl#FunctionalProperty",
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The sampling campaign the observation belongs to; part of the observation's identity key."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "http://www.w3.org/ns/sosa/Observation"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "during campaign"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/Campaign"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/ArithmeticMean",
    "@type": [
      "https://w3id.org/censo/reg/AggregationFunction"
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "arithmetic mean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/NonRelevantMetabolite",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Metabolite without the parent's pesticidal activity; brought into scope by the 2026 EU update under a separate standard."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Non-relevant metabolite"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#subClassOf": [
      {
        "@id": "https://w3id.org/censo/Analyte"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/retentionTime",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "Chromatographic retention time used to confirm analyte identity within the run."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/MassSpectrometryTransition"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "retention time"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#decimal"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/appliesToGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance group whose aggregate the threshold constrains."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "applies to group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "https://w3id.org/censo/reg/SubstanceGroup"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/Jurisdiction",
    "@type": [
      "http://www.w3.org/2002/07/owl#Class"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "A legal territory in which a regulation package applies, identified by an ISO 3166 code or by 'EU'."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "Jurisdiction"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/reg/requiresCompleteGroup",
    "@type": [
      "http://www.w3.org/2002/07/owl#DatatypeProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "True when every group member must have been measured for the\naggregate to be assessable. If members are missing from the monitoring panel,\nthe aggregate is `censo:IndeterminateCompliance`, not a partial sum. The 24-PFAS\nsum is the obvious case: a survey that measured none of them cannot report\ncompliance."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/reg/GroupThreshold"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#label": [
      {
        "@language": "en",
        "@value": "requires complete group"
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#range": [
      {
        "@id": "http://www.w3.org/2001/XMLSchema#boolean"
      }
    ]
  },
  {
    "@id": "https://w3id.org/censo/appliesToAnalyte",
    "@type": [
      "http://www.w3.org/2002/07/owl#ObjectProperty"
    ],
    "http://www.w3.org/2000/01/rdf-schema#comment": [
      {
        "@language": "en",
        "@value": "The substance constrained. Group thresholds use cereg:appliesToGroup instead."
      }
    ],
    "http://www.w3.org/2000/01/rdf-schema#domain": [
      {
        "@id": "https://w3id.org/censo/Threshold"
      }
    ],
