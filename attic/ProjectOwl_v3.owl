<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#"
     xml:base="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:untitled-ontology-15="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Segmentation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Segmentation"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#contain -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#contain">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ObservationPoint"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Pollutant"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#denominator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#denominator">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#expose -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#expose"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#feature -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#feature"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#from -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#from">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Segmentation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#RiverSegment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Node"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#has -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#has"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#hasDate -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#hasDate">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Date"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#hasUnit -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#hasUnit">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#UnitOfMeasure"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#isA -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#isA"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#isPartOf -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#isPartOf"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#locatedIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#locatedIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#makingIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#makingIn">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ObservationPoint"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#measure -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#measure"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#measuredBy -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#measuredBy">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Quantity"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#UnitOfMeasure"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#numerator -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#numerator">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observe -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observe">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observer"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#prefix -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#prefix">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#observation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#UnitOfMeasure"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Prefix"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#to -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#to">
        <rdfs:subPropertyOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Segmentation"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#RiverSegment"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Node"/>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#within -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#within">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Node"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ObservationPoint"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#RiverSegment"/>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ObservationValue -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ObservationValue">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#altitude -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#altitude">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Spatial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#latitude -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#latitude">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Spatial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#longitude -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#longitude">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Spatial"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#magnitude -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#magnitude"/>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#standardDeviation -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#standardDeviation">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Observation"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#symbol -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#symbol">
        <rdfs:domain>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Quantity"/>
                    <rdf:Description rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#UnitOfMeasure"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#treeLevel -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#treeLevel">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#RiverSegment"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Acceleration -->

    <owl:Class rdf:about="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Acceleration">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#Quantity"/>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/recep/ontologies/2018/0/untitled-ontology-15#ActiveConc -->

